{
  "name": "brod-alarm-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data pipeline for Brod Alarm: scrapes cruise schedule + generates forecast JSON.",
  "scripts": {
    "scrape": "tsx scrape-cruises.ts",
    "forecast": "tsx generate-forecast.ts",
    "sync": "tsx sync-static.ts",
    "zones:export": "tsx zones-export-geojson.ts",
    "zones:import": "tsx zones-import-geojson.ts",
    "build:data": "npm run scrape && npm run sync && npm run forecast",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
